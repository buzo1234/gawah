 "lines": {
  "1": "Ananya: hello हां संतोष जी मैं अनन्या बोल रही हूं वो आपका नंबर society के guard ने दिया था\n",
  "2": "Santosh: हां madam नमस्कार बोलो\n",
  "3": "Ananya: मुझे full time driver चाहिए monday से saturday मेरी गाड़ी है creta automatic\n",
  "4": "Santosh: हां चलेगा madam automatic मैंने चलाया है पहले तीन साल एक डॉक्टर साहब के पास था\n",
  "5": "Ananya: ok timing होगी सुबह साड़ी आठ से शाम सात तक कभी कभी late हो सकता है\n",
  "6": "Santosh: साढ़े आठ से सात ठीक है और सात के बाद रुकना पड़ा तो overtime लगेगा madam\n",
  "7": "Ananya: हां वो ठीक है कितना लेते हो आप\n",
  "8": "Santosh: देखो madam salary बीस हज़ार और overtime डेढ़ सौ घंटा\n",
  "9": "Ananya: बीस थोड़ा ज़्यादा है यार इस area में सब सोलह सत्रह में मिल जाते हैं\n",
  "10": "Santosh: सोलह में नहीं होगा madam घर से आने का petrol भी है अठारह कर दो\n",
  "11": "Ananya: अठारह ok चलो ठीक है तो कल से आ जाओ साढ़े आठ बजे building के नीचे\n",
  "12": "Santosh: कल से ठीक है madam और overtime का\n",
  "13": "Ananya: डेढ़ सौ ठीक है घंटे का but रोज़ रोज़ नहीं होगा\n",
  "14": "Santosh: हां हां\n",
  "15": "Ananya: और देखो advance वगैरह मैं नहीं दूंगी पहले भी एक driver advance लेके\n",
  "16": "Ananya: गायब हो गया था salary हर महीने की एक तारीख को GPay कर दूंगी\n",
  "17": "Santosh: ठीक है madam कोई बात नहीं advance नहीं चाहिए एक तारीख चलेगा\n",
  "18": "Ananya: ok और sunday को कभी कभी चाहिए होगा मेरे parents आते हैं तो mall वगैरह\n",
  "19": "Santosh: sunday को आ जाऊंगा madam पर sunday का अलग देना पड़ेगा पूरे दिन का\n",
  "20": "Ananya: हम्म ठीक है ठीक है वो देखते हैं जब होगा और हां गाड़ी में smoking बिल्कुल नहीं\n",
  "21": "Santosh: नहीं madam मैं smoke नहीं करता गुटखा भी नहीं\n",
  "22": "Ananya: good और leave का क्या महीने में कितनी\n",
  "23": "Santosh: दो छुट्टी madam और बीमार हुआ तो पहले बता दूंगा\n",
  "24": "Ananya: दो ठीक है बस बीच में छोड़ के मत जाना पिछले वाले ने यही किया था\n",
  "25": "Santosh: नहीं madam मैं ऐसा आदमी नहीं हूं डॉक्टर साहब के पास तीन साल रहा उनसे पूछ लो\n",
  "26": "Ananya: हां ठीक है उनका number भेज देना whatsapp पे\n",
  "27": "Santosh: भेजता हूं madam और license की copy भी\n",
  "28": "Ananya: हां aadhaar भी police verification के लिए\n",
  "29": "Santosh: हां ठीक है\n",
  "30": "Ananya: ok संतोष एक minute मेरा दूसरा call आ रहा है office से\n",
  "31": "Ananya: हां तो कल साढ़े आठ bye\n",
  "32": "Santosh: हां madam नम\n"
 },
