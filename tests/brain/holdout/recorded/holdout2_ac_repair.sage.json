 "lines": {
  "1": "Vikas: हेलो madam मैं विकास बोल रहा हूं कूल केयर से आपने AC service के लिए call किया था\n",
  "2": "Lakshmi: हां हां विकास जी नमस्ते drawing room और बच्चों वाले room का service करवाना है और मेरे bedroom वाला तो ठंडा ही नहीं कर रहा\n",
  "3": "Vikas: ठीक है madam bedroom वाले में gas कम होगी शायद या फिर compressor कितना पुराना है\n",
  "4": "Lakshmi: सात आठ साल हो गए वॉल्टर्स का है\n",
  "5": "Vikas: अच्छा देखिए service का छह सौ एक AC का होता है gas full भरनी पड़ी तो दाई हज़ार और compressor गया तो साढ़े सात से आठ हज़ार लगेगा वो बाद की बात है\n",
  "6": "Lakshmi: इतना सारा मैं तो सिर्फ service के लिए बोल रही थी\n",
  "7": "Vikas: नहीं madam gas तो देख के ही बताऊंगा पहले से नहीं बोल सकता\n",
  "8": "Lakshmi: हां हां ठीक है देखिए ना पहले वो दोनों का service कितने में करोगे\n",
  "9": "Vikas: दोनों का बारह सौ बनता है पर हज़ार कर दूंगा आप regular customer बन जाओ बस\n",
  "10": "Lakshmi: ठीक है हज़ार और bedroom वाला भी देख लेना साथ में\n",
  "11": "Vikas: हां हां वो भी देख लूंगा कोई बात नहीं उसी में\n",
  "12": "Lakshmi: और gas भरी तो कितना बोला आपने दो हज़ार\n",
  "13": "Vikas: ढाई madam दो हज़ार पांच सौ पर gas भरी तो उस AC का service free\n",
  "14": "Lakshmi: अच्छा ठीक है कब आओगे\n",
  "15": "Vikas: कल सुबह ग्यारह बजे तक पहुंच जाऊंगा दो घंटे का काम है\n",
  "16": "Lakshmi: ग्यारह ठीक है पर बारह के बाद मुझे hospital जाना है checkup के लिए\n",
  "17": "Vikas: हां तो ग्यारह से पहले ही आ जाऊंगा madam साढ़े दस तक\n",
  "18": "Lakshmi: और पैसे पहले देने हैं क्या कुछ\n",
  "19": "Vikas: नहीं नहीं madam advance कुछ नहीं काम होने के बाद cash या UPI जो आपको ठीक लगे\n",
  "20": "Lakshmi: cash दे दूंगी मेरे पास UPI ठीक से चलता नहीं बेटा set करके गया था\n",
  "21": "Vikas: कोई बात नहीं cash चलेगा\n",
  "22": "Lakshmi: और अगर फिर से ठंडा नहीं किया तो पिछली बार वाला लड़का पैसे लेके गया फिर दो दिन में वही हाल\n",
  "23": "Lakshmi: फिर फोन भी नहीं उठाया\n",
  "24": "Vikas: madam gas की तीन महीने की warranty है लीक हुई तो free में दोबारा भरूंगा और service में कुछ हुआ तो पंद्रह दिन में free में आऊंगा\n",
  "25": "Lakshmi: ठीक है ये अच्छा है\n",
  "26": "Lakshmi: और compressor वाला अगर हुआ तो\n",
  "27": "Vikas: वो madam खोल के ही पता चलेगा company का लगाएंगे तो आठ हज़ार लोकल वाला आठ से कम में हो जाएगा\n",
  "28": "Lakshmi: अरे बाप रे आठ हज़ार वो बाद में बात करते हैं पहले आप देख लो बेटे से भी पूछना पड़ेगा\n",
  "29": "Vikas: हां हां बिल्कुल पहले check करते हैं फिर बता दूंगा\n",
  "30": "Lakshmi: ठीक है विकास जी तो कल साढ़े दस बाकी बाद में बात करते हैं\n",
  "31": "Vikas: जी madam address वही है ना मयूर विहार फेज़ वन पॉकेट फोर\n",
  "32": "Lakshmi: हां वही तीसरी मंज़िल lift नहीं है\n",
  "33": "Vikas: कोई बात नहीं madam चढ़ जाएंगे ठीक है नमस्ते\n",
  "34": "Lakshmi: नमस्ते\n"
 },
