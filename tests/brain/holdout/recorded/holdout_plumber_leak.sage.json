 "holes": [],
 "lines": {
  "1": "Raju: Haan ji, Raju bol raha hoon. Plumber.\n",
  "2": "Sunita: Haan Raju bhaiya, namaste, main Sunita Khanna, B-block se. Mehra ji ne aapka number diya tha. Woh hamare bathroom mein na leakage ho raha hai.\n",
  "3": "Raju: Kahan se? Tap se ya neeche se?\n",
  "4": "Sunita: Neeche se lagta hai, deewar mein seelan aa gayi hai, aur neeche wale flat mein bhi paani tapak raha hai. Unhone do baar complain kar diya, bahut chik chik karte hain woh log.\n",
  "5": "Raju: Concealed pipe hoga. Tile todni padegi.\n",
  "6": "Sunita: Haaye, tile? Abhi do saal pehle hi toh lagwayi thi. Mere bete ne pasand ki thi woh tiles, Bangalore mein hai woh, aata hi nahi hai.\n",
  "7": "Raju: Do teen tile. Pipe badal ke wapas laga denge. Tile aapki hogi toh wahi lagegi.\n",
  "8": "Sunita: Haan haan, extra tiles rakhi hain store mein, kahin toh hongi. Toh kitna lagega sab?\n",
  "9": "Raju: Pipe, fitting, cement, labour, sab milake paintalis sau.\n",
  "10": "Sunita: Paintalis sau matlab four thousand five hundred? Thoda zyada nahi hai?\n",
  "11": "Raju: Concealed kaam hai madam. Itna hi lagega.\n",
  "12": "Sunita: Accha theek hai. Mehra ji keh rahe the aap kaam accha karte ho. Woh unke yahan kitchen ka bhi aapne kiya tha na?\n",
  "13": "Raju: Haan. Kab karwana hai?\n",
  "14": "Sunita: Jitna jaldi ho sake. Kal aa sakte ho?\n",
  "15": "Raju: Kal subah das baje. Ek din ka kaam hai, shaam tak ho jayega.\n",
  "16": "Sunita: Theek hai das baje. Arre haan, society wale gate pe entry karwate hain, aap guard ko naam bata dena, Sunita Khanna, B-204.\n",
  "17": "Raju: Theek hai. Material ke liye pandrah sau pehle dena padega. Aaj hi.\n",
  "18": "Sunita: Pandrah sau aaj? Accha chalo, GPay pe bhej deti hoon, yahi number hai na?\n",
  "19": "Raju: Haan yahi number. Aur baaki ka?\n",
  "20": "Sunita: Arre baaki ki tension mat lo bhaiya, mil jayega, main kaun sa bhaag rahi hoon. Waise woh geyser bhi thoda awaaz karta hai, woh bhi dekh loge kal?\n",
  "21": "Raju: Dekh lunga. Woh alag hoga.\n",
  "22": "Sunita: Haan haan, alag de dungi. Aur kitchen ka sink bhi dheere nikalta hai paani, blockage hai shayad.\n",
  "23": "Raju: Kal dekh lenge sab.\n",
  "24": "Sunita: Haan wahi. Pichhle wale plumber ne toh aadha kaam karke chhod diya tha, baad mein phone hi nahi uthata tha.\n",
  "25": "Raju: Hmm.\n",
  "26": "Sunita: Aapko toh Mehra ji jaante hain, isliye bharosa hai. Accha, cement wagairah aap le aaoge na? Mujhe kuch mangwana toh nahi?\n",
  "27": "Raju: Sab le aaunga. Aap bas tile nikaal ke rakhna.\n",
  "28": "Sunita: Haan woh main aaj hi dhoond leti hoon. Bete ko bhi phone karke poochhti hoon kahan rakhi thi.\n",
  "29": "Raju: Theek hai madam.\n",
  "30": "Sunita: Accha chalo phir, main paise bhej deti hoon, baaki kal aap aaoge toh baat karte hain.\n",
  "31": "Raju: Haan theek hai. Chalo phir baat karte hain.\n",
  "32": "Sunita: Haan ji, chalo phir baat karte hain.\n"
 },
