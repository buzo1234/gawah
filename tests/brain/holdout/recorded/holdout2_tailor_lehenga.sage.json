 "holes": [],
 "lines": {
  "1": "Sunita: Hello, Master ji? Main Sunita bol rahi hoon, Bansal, Model Town wali. Pichhle saal aapne meri bahu ka suit banaya tha.\n",
  "2": "Iqbal: Haan ji haan, Bansal ji, yaad hai. Namaste. Boliye.\n",
  "3": "Sunita: Master ji, beti ki shaadi hai, baarah December ko. Uska kaam karwana hai aapse. Lehenga ka blouse aur kuch suits.\n",
  "4": "Iqbal: Mubarak ho ji, bahut mubarak. Kitne suit?\n",
  "5": "Sunita: Chaar suit. Aur lehenga ka blouse, aur lehenga ki fitting bhi. Kapda sab mera hai, main de jaungi.\n",
  "6": "Iqbal: Theek. Dekhiye, blouse aur lehenga ki silai saade chaar hazaar, aur suit baarah sau ek, chaar ke hue adtaalis sau. Lining aap le aana, woh main nahi rakhta.\n",
  "7": "Sunita: Arre baap re, nau hazaar teen sau? Master ji, itna to nahi. Pichhli baar to aapne...\n",
  "8": "Iqbal: Pichhli baar ek suit tha, Bansal ji. Ye bridal kaam hai, blouse mein haath ka kaam lagega.\n",
  "9": "Sunita: Achha suniye, aath hazaar kar lijiye sab. Main to purani customer hoon.\n",
  "10": "Iqbal: Aath mein nahi hoga ji. Haan, nau hazaar kar deta hoon, round figure.\n",
  "11": "Sunita: Nau hazaar... saara saaman milake na? Latkan, dori, sab?\n",
  "12": "Iqbal: Haan ji, saaman milake. Latkan to main achhe wale lagata hoon, Chandni Chowk se laata hoon.\n",
  "13": "Sunita: Theek hai, theek hai. Accha, trial kab hoga?\n",
  "14": "Iqbal: Kapda kal parson de jaiye, to trial agle Sunday ko, aur poora maal paanch December tak ready.\n",
  "15": "Sunita: Paanch tak? Shaadi baarah ko hai... haan, theek hai, ek hafta pehle mil jayega to alteration ka time rahega.\n",
  "16": "Iqbal: Bilkul. Koi dheela tight hua to wahin theek kar denge.\n",
  "17": "Sunita: Paise ka batayiye, advance kitna?\n",
  "18": "Iqbal: Jo aap theek samjhein. Aadha de dijiye.\n",
  "19": "Sunita: Aadha to abhi nahi ho payega, shaadi ke kharche hain. Do hazaar abhi PhonePe kar deti hoon, baaki jab maal uthaungi tab.\n",
  "20": "Iqbal: Chaliye koi baat nahi. Do hazaar sahi hai.\n",
  "21": "Sunita: Aur Master ji, ek baat. Agar paanch tak ready nahi hua to? Pichhli baar Diwali pe aapne teen din late kiya tha.\n",
  "22": "Iqbal: Arre woh to bijli chali gayi thi poore hafte. Is baar nahi hoga, aap tension mat lo. Pachchees saal se kaam kar raha hoon.\n",
  "23": "Sunita: Haan wo to hai. Accha, beti ka naap aap loge ya purane blouse se kaam chal jayega?\n",
  "24": "Iqbal: Beti ko le aaiye ek baar, bridal mein purane naap se nahi chalta. Naap sahi lena padta hai.\n",
  "25": "Sunita: Gawah ji, aap sun rahe ho na? Maine advance kitna bola, do hazaar hi na? Baad mein main bhool jaati hoon.\n",
  "26": "Iqbal: Haan haan, likh lijiye, sab saaf rahe.\n",
  "27": "Sunita: Chalo. Accha Master ji, Pinky ke lehenge ka rang dekhoge to khush ho jaoge. Mehroon hai.\n",
  "28": "Iqbal: Achha ji. Mehroon pe golden latkan bahut jachega.\n",
  "29": "Sunita: Haan haan. Aur suno, uski saas bhi ek tailor jaanti hain Lajpat Nagar mein, par maine kaha nahi ji, hamare Master ji hi karenge.\n",
  "30": "Iqbal: Meherbani aapki. Bas kapda jaldi pahuncha dijiye.\n",
  "31": "Sunita: Kal pakka. Kal shaam ko Pinky ke papa chhod jayenge. Chalo phir, rakhti hoon.\n",
  "32": "Iqbal: Ji, namaste.\n",
  "33": "Sunita: Haan, aur lining bhi bhijwa dungi saath mein... ya aap le aaoge? Chalo kal dekh lenge. Namaste.\n",
  "34": "Iqbal: Ji ji. Khuda hafiz.\n"
 },
