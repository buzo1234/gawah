 "lines": {
  "1": "Ramesh: हेलो हां हेलो कमला जी बोल रही हैं\n",
  "2": "Kamla: हां जी बोल रही हूं आप शर्मा जी\n",
  "3": "Ramesh: हां हां मैं शर्मा बोल रहा हूं वो गुप्ता जी की बहू ने बताया था आप खाना बनाती हैं\n",
  "4": "Kamla: हां जी बनाती हूं तीन घर में बनाती हूं अभी आपके यहां कितने लोग हैं\n",
  "5": "Ramesh: बस हम दो जने हैं मैं और मेरी wife ठीक है बच्चे सब बाहर हैं\n",
  "6": "Kamla: अच्छा तो दोनों टाइम का चाहिए या एक टाइम\n",
  "7": "Ramesh: दोनों टाइम सुबह का नशा और lunch एक साथ और रात का खाना ठीक है\n",
  "8": "Kamla: हां ठीक है सुबह दस बजे तक आ जाऊंगी नाश्ता lunch दोनों बना दूंगी और शाम को सात बजे\n",
  "9": "Ramesh: ठीक है ठीक है और देखिए हम लोग तीखा नहीं खाते मेरी wife को sugar है तो\n",
  "10": "Ramesh: मीठा बिल्कुल नहीं और रात को हल्का दलिया खिचड़ी ऐसा\n",
  "11": "Kamla: हां जी समझ गई बुज़ुर्ग लोगों के यहां ऐसा ही बनता है बर्तन भी मुझे करने हैं क्या\n",
  "12": "Ramesh: नहीं नहीं बर्तन वाली अलग आती है ठीक है\n",
  "13": "Kamla: तो फिर दोनों टाइम का आठ हज़ार महीना\n",
  "14": "Ramesh: आठ हज़ार बहुत ज़्यादा है कमला जी हम तो सात दे रहे थे पहले वाली को\n",
  "15": "Kamla: शर्मा जी आजकल सब यही ले रहे हैं दो टाइम का आठ से कम कोई नहीं करेगा\n",
  "16": "Ramesh: अच्छा ठीक है ठीक है वो देख लेंगे आप पहले खाना तो बनाइए फिर बात करते हैं\n",
  "17": "Kamla: ठीक है जी\n",
  "18": "Ramesh: और छुट्टी कितनी लेती हैं आप\n",
  "19": "Kamla: महीने में दो छुट्टी लेती हूं और पहले से बता देती हूं\n",
  "20": "Ramesh: ठीक है दो ठीक है advance वगैरह चाहिए क्या\n",
  "21": "Kamla: नहीं advance नहीं चाहिए महीना पूरा होने पे पूरा दे देना\n",
  "22": "Ramesh: ठीक है महीने के end में ठीक है कब से आ सकती हैं\n",
  "23": "Kamla: कल से आ जाती हूं कल सुबह दस बजे\n",
  "24": "Ramesh: ठीक है कल से एक महीना देखते हैं फिर आगे का सोचेंगे ठीक है\n",
  "25": "Kamla: हां जी एक महीना देख लीजिए पसंद आए तो रखिए\n",
  "26": "Ramesh: ठीक है और राशन सब्ज़ी वो सब घर में रहता है आपको कुछ लाना नहीं है\n",
  "27": "Kamla: ठीक है जी तो कल आती हूं\n",
  "28": "Ramesh: हां ठीक है अरे हां वो पैसे वाली बात तो रह गई\n",
  "29": "Kamla: हां जी\n",
  "30": "Ramesh: चलिए ना आपकी ना मेरी साढ़े सात हज़ार कर लेते हैं ठीक है\n",
  "31": "Kamla: ठीक है शर्मा जी साढ़े सात चलेगा\n",
  "32": "Ramesh: ठीक है फिर कल मिलते हैं गुप्ता जी की बहू को भी बता दूंगा ठीक है\n",
  "33": "Kamla: हां जी नमस्ते\n"
 },
