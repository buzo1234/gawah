 "lines": {
  "1": "Suresh: हां हेलो इमरान भाई सुरेश बोल रहा हूं electrician\n",
  "2": "Imran: हां बोलो दुकान देख ली थी कल\n",
  "3": "Suresh: हां देख ली भाई पूरी wiring पुरानी है एकदम aluminium की है अभी तक मैं तो हैरान हो गया आजकल कौन aluminium लगाता है\n",
  "4": "Imran: पूरी बदलनी है\n",
  "5": "Suresh: हां पूरी बदलनी पड़ेगी copper की डालेंगे Havells या Polycab जो आप बोलो और एक नया MCB box लगेगा\n",
  "6": "Imran: Polycab ठीक है points कितने\n",
  "7": "Suresh: आठ socket point है counter पे चार पीछे चार उसके अलावा दो light और AC की अलग line\n",
  "8": "Imran: AC का भी हां ठीक है total बोलो\n",
  "9": "Suresh: देखो भाई सब मिला के material labour सब सत्रह हज़ार\n",
  "10": "Imran: सत्रह ज़्यादा है पंद्रह कर लो\n",
  "11": "Suresh: इमरान भाई copper का rate आपको पता है आजकल आसमान पे है सत्रह से कम नहीं होगा सच बोल रहा हूं मेरा अपना कुछ नहीं बचता\n",
  "12": "Imran: ठीक है सत्रह\n",
  "13": "Suresh: हां तो advance पांच हज़ार दे देना जिस दिन start करूं material उठाना पड़ता है\n",
  "14": "Imran: ठीक है पांच start वाले दिन बाकी\n",
  "15": "Imran: काम ख़तम होते ही\n",
  "16": "Suresh: हां हां उसी दिन ले लूंगा कोई दिक्कत नहीं\n",
  "17": "Imran: start कब\n",
  "18": "Suresh: सोमवार से कर देता हूं सोमवार को वैसे भी मेरे पास दूसरी कोई site नहीं है वो गुप्ता जी का मकान था वो ख़तम हो गया\n",
  "19": "Imran: कितने दिन लगेंगे दुकान बंद रखनी पड़ेगी मुझे\n",
  "20": "Suresh: अरे भाई जल्दी कर दूंगा आप चिंता मत करो मेरा काम साफ़ होता है पूछ लो market में किसी से भी वो सामने वाली medical shop की wiring भी मैंने की थी\n",
  "21": "Imran: हम्म\n",
  "22": "Suresh: और वो जो board है ना पुराना वो भी हटा देंगे नया modular लगा देंगे वो free में\n",
  "23": "Imran: ठीक है देर हुई तो हर दिन का पांच सौ काटूंगा ये पहले बता रहा हूं\n",
  "24": "Suresh: हां ठीक है भाई काट लेना इतना भरोसा है अपने काम पे\n",
  "25": "Imran: और कुछ\n",
  "26": "Suresh: बस तो सोमवार सुबह नौ बजे आ जाऊंगा दो लड़के साथ होंगे seventy हज़ार में पूरा काम poly cap वाला MCB के साथ\n",
  "27": "Imran: हां\n",
  "28": "Suresh: और दुकान की चाबी किसके पास रहेगी आप होगे सुबह\n",
  "29": "Imran: मैं रहूंगा\n",
  "30": "Suresh: ठीक है फिर अरे भाई मेरा दूसरा call आ रहा है गुप्ता जी का\n",
  "31": "Imran: हां ठीक\n"
 },
