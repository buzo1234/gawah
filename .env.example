# Copy to .env and fill in. Never commit .env.
# With no .env at all, run the offline mode instead: uv run python -m tests.offline --port 8000
# Keys marked "shell only" are read from the environment, not from this file:
# export them in the shell (or put them in the server's environment).

# --- Outside services (the full mode needs all of these) ---

# OpenAI - transcription, the realtime voice, the Scribe, reading messages, the agreement, the spoken summary
OPENAI_API_KEY=

# AWS - S3 for recordings, voice notes, screenshots and agreement PDFs
# A session token means the keys are temporary. Replace all three together when they expire.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=
S3_BUCKET=

# LiveKit - the call itself (rooms in the browser)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Levanto Sage2 - the live yes/no decisions on each call line
SAGE_API_KEY=

# --- WhatsApp ---

# Which provider sends: twilio (the sandbox, the default) or meta (the Cloud API).
# Steps for meta are in tools/META-SETUP.md.
WHATSAPP_PROVIDER=

# Meta WhatsApp Cloud API (the free test number: up to 5 verified recipient phones)
# A temporary token from WhatsApp > API Setup expires within hours; a System User token does not.
META_WHATSAPP_TOKEN=
# The test number's "Phone number ID" (not the phone number itself), from WhatsApp > API Setup
META_PHONE_NUMBER_ID=
# Any string you choose; type the same one into the webhook settings on Meta's dashboard
META_VERIFY_TOKEN=
# App settings > Basic > App secret. Checks that a webhook really came from Meta.
# Empty: webhooks are taken unsigned, with a loud warning in the log. Required when ACCESS_KEY is set.
META_APP_SECRET=
# Graph API version in Meta's URLs. Empty means v27.0.
META_GRAPH_VERSION=

# Twilio - the WhatsApp sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sandbox number from your Twilio console, like whatsapp:+1XXXXXXXXXX. Join it by sending the code shown there.
TWILIO_WHATSAPP_NUMBER=
# Optional: a Twilio voice number, only for a real ringing call. Not used by the browser calls.
TWILIO_PHONE_NUMBER=

# The only numbers Gawah may message or call. Comma-separated, with country code, like +9198XXXXXXXX.
# Any other number is a simulated phone: shown on the dashboard, never sent.
VERIFIED_NUMBERS=

# The public https address of this server (a tunnel on a laptop). Used in links and for webhooks.
PUBLIC_BASE_URL=

# --- Behaviour (the defaults are fine) ---

# live = Gawah picks its moment to speak. wrapup = it speaks only at the end of the call.
JUDGE_MODE=live
# How long Gawah waits for a WhatsApp yes or no before it follows up
REPLY_TIMEOUT_SECONDS=120
# false: no call-back after a deal call; what both agreed on the call counts as confirmed and the agreement is sent at once
# CALLBACKS_ENABLED=true
# Where the SQLite file lives. Empty means gawah.db in the project folder.
DATABASE_PATH=
# The development routes (/dev/publish, used by tools/replay.py, and the actor's routes). false removes them.
DEV_ROUTES=true
# 1 turns on the "AI plays this person" routes (/actor/...). Needs DEV_ROUTES on.
# ACTOR_ROUTES=
# Set on a public server: the dashboard and the routes behind it ask for this key once.
# Keep it in .env.deploy on the server, not in a laptop's .env.
# ACCESS_KEY=

# --- Shell only (read from the environment, not from .env) ---

# The AWS Secrets Manager secret to read settings from (the server sets gawah/prod)
# GAWAH_SECRET_ID=
# Seconds between "work done, money owed" and the hirer's reminder (default 60)
# SENTINEL_BALANCE_REMINDER_SECONDS=
# Hours after a money term's date passes before its reminder (default 9)
# SENTINEL_DATE_REMINDER_HOURS_AFTER=
# 1 runs the PDF browser with --no-sandbox (needed inside Docker)
# GAWAH_CHROME_NO_SANDBOX=
# 1 sends a replayed call to the live Sage2 and OpenAI models instead of the saved replies (billed per line)
# BRAIN_LIVE_REPLAYS=
# MEMORY_LIVE_REPLAYS=
