# Copy to .env and fill in. Never commit .env.

# --- Needed now (scaffold and spikes) ---

# OpenAI - transcription, realtime voice, reasoning
OPENAI_API_KEY=

# AWS - S3 for recordings and PDFs, Bedrock and Transcribe as backups
# A session token means these are temporary and will expire. Replace all three together when they do.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=
S3_BUCKET=

# LiveKit - the call itself (free plan: use with care)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Which WhatsApp provider sends: twilio (the sandbox, the default) or meta (the Cloud API).
# Steps for meta are in tools/META-SETUP.md.
WHATSAPP_PROVIDER=

# Meta WhatsApp Cloud API (free test number: up to 5 verified recipient phones)
# The access token: a temporary one from WhatsApp > API Setup expires within hours; a System User token does not.
META_WHATSAPP_TOKEN=
# The test number's "Phone number ID" (not the phone number itself), from WhatsApp > API Setup
META_PHONE_NUMBER_ID=
# Any string you choose; type the same one into the webhook settings on Meta's dashboard
META_VERIFY_TOKEN=
# App settings > Basic > App secret. Checks that a webhook really came from Meta.
META_APP_SECRET=
# Graph API version in Meta's URLs. Empty means v27.0.
META_GRAPH_VERSION=

# Twilio - the WhatsApp sandbox only (free trial: use with care)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sandbox number shown in your Twilio console, like whatsapp:+1XXXXXXXXXX. Join by sending the code shown there to it.
TWILIO_WHATSAPP_NUMBER=

# Levanto Sage2 - live decisions and extraction
SAGE_API_KEY=

# The only numbers Gawah may message or call. Comma-separated, with country code, like +9198XXXXXXXX
VERIFIED_NUMBERS=

# The cloudflared tunnel address. Changes each time the tunnel restarts.
PUBLIC_BASE_URL=

# --- Demo settings (defaults are fine) ---

# live = Judge picks its moment. wrapup = Judge speaks only at the end (the safety switch).
JUDGE_MODE=live
# How long the WhatsApp bot waits for a reply before Gawah follows up
REPLY_TIMEOUT_SECONDS=120
# Where the SQLite file lives. Empty means gawah.db in the project folder.
DATABASE_PATH=
# The development-only route that puts events on the bus (the replayer uses it). false removes it.
DEV_ROUTES=true

# --- Only if we fall back ---

# Twilio trial phone number (only for a real ringing follow-up call, or if LiveKit fails)
TWILIO_PHONE_NUMBER=
